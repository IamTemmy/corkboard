# The site's public base URL — used for page metadata and the link-preview
# image. Copy this file to .env.local for local development, and set the same
# variable in Vercel (Project Settings → Environment Variables) for production.
NEXT_PUBLIC_SITE_URL=https://corkboard-six.vercel.app

# Supabase (the backend: database, auth, storage). Find these in your Supabase
# project under Connect / API Keys. The URL and the anon/publishable key are
# safe to expose (protected by Row Level Security). Never put the service_role
# / secret key here — that one stays private.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
